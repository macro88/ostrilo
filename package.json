{
  "name": "Ostrilo",
  "description": "Nostr signer. Signs locally, never snoops",
  "private": true,
  "version": "0.0.1",
  "license": "MIT",
  "packageManager": "pnpm@11.5.2",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:manifest": "wxt build && wxt build -b firefox && OSTRILO_REQUIRE_BUILD_OUTPUT=1 vitest run tests/security/manifest-assertions.test.ts",
    "test:build-output": "wxt build && wxt build -b firefox && OSTRILO_REQUIRE_BUILD_OUTPUT=1 vitest run tests/security/manifest-assertions.test.ts tests/security/key-handling-bundle.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:coverage:ui": "vitest --coverage --ui",
    "test:ci": "vitest run --coverage --reporter=junit --outputFile=test-results.xml",
    "postinstall": "wxt prepare",
    "test:e2e": "playwright test --project=chromium-extension",
    "test:e2e:headed": "OSTRILO_E2E_HEADED=1 playwright test --project=chromium-extension --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "OSTRILO_E2E_HEADED=1 playwright test --project=chromium-extension --debug",
    "test:e2e:smoke": "playwright test tests/e2e/agent-smoke.spec.ts --project=chromium-extension",
    "agent:build": "wxt build -m agent",
    "agent:loop": "node -e \"fs.rmSync('test-results/agent',{recursive:true,force:true})\" && OSTRILO_E2E_BUILD_MODE=agent OSTRILO_E2E_HEADED=1 OSTRILO_E2E_SCREENSHOT_DIR=test-results/agent playwright test --project=agent-scratch",
    "agent:loop:prod": "node -e \"fs.rmSync('test-results/agent',{recursive:true,force:true})\" && OSTRILO_E2E_HEADED=1 OSTRILO_E2E_SCREENSHOT_DIR=test-results/agent playwright test --project=agent-scratch",
    "agent:screens": "OSTRILO_E2E_BUILD_MODE=agent OSTRILO_E2E_SCREENSHOT_DIR=test-results/agent playwright test --project=agent-scratch tests/e2e/agent-screens.spec.ts",
    "agent:clean": "node -e \"fs.rmSync('test-results/agent',{recursive:true,force:true})\" && rm -f tests/e2e/*.scratch.spec.ts",
    "doctor": "react-doctor"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@radix-ui/react-avatar": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-slider": "^1.4.0",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-switch": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.14",
    "@scure/base": "^2.2.0",
    "@tailwindcss/vite": "^4.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "three": "^0.184.0",
    "webextension-polyfill": "^0.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@types/webextension-polyfill": "^0.12.5",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "5.0.4",
    "@vitest/coverage-v8": "^4.1.8",
    "@wxt-dev/auto-icons": "^1.1.1",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.10.0",
    "http-server": "^14.1.1",
    "jsdom": "^29.1.1",
    "react-doctor": "0.9.14",
    "shadcn": "^4.11.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.5",
    "vite-plugin-commonjs": "^0.10.4",
    "vitest": "^4.1.8",
    "wxt": "0.20.26"
  }
}
