# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
.output
.wxt
web-ext.config.ts

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

coverage

# Test artifacts
test-results/
playwright-report/
*.bak

# Agent scratch specs are disposable; see docs/agent-loop.md
tests/e2e/*.scratch.spec.ts

# aislop runtime artifacts: score history, hook baselines, repair sessions.
# Only the checked-in config is shared; the rest is local state.
.aislop/*
!.aislop/config.yml
# aislop also writes a session file beside whatever it repairs, which is how
# one ended up inside an OpenSpec change directory. Any .aislop below the root
# is local state too.
*/**/.aislop/

# Design-review screenshots are regenerated by capture-screenshots.mjs and not
# vendored — the two the README embeds are the only tracked exceptions.
docs/design-review/screenshots/*
!docs/design-review/screenshots/dark/
!docs/design-review/screenshots/23-popup-home-populated.png
docs/design-review/screenshots/dark/*
!docs/design-review/screenshots/dark/23-popup-home-populated.png
