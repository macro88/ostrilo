{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",

    "paths": {
      "@/*": ["./src/*"],
      "@/components/*": ["./src/ui/components/*"],
      "@/hooks/*": ["./src/ui/hooks/*"],
      "@/lib/*": ["./src/ui/lib/*"],
      "@/assets/*": ["./src/assets/*"],
      "@/infrastructure/*": ["./src/infrastructure/*"],
      "@/application/*": ["./src/application/*"],
      "@/domain/*": ["./src/domain/*"]
    }
  }
}
